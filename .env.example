# OPTION 1: Upstox API Configuration (Real-time WebSocket + Historical data)
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Upstox OAuth 2.0 Configuration (for automatic token refresh)
UPSTOX_CLIENT_ID=your_upstox_client_id_here
UPSTOX_CLIENT_SECRET=your_upstox_client_secret_here
# For local development:
UPSTOX_REDIRECT_URI=http://localhost:3000/callback
# For production (Render):
# UPSTOX_REDIRECT_URI=https://ema5-alert-system.onrender.com/callback

# OPTION 2: Alpha Vantage API Configuration (Alternative real-time data source)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Instrument Configuration for Upstox (Nifty 50 Index - 5 minute timeframe)
INSTRUMENT_KEY=NSE_INDEX|NIFTY 50

# Symbol Configuration for Alpha Vantage (Nifty 50)
SYMBOL=NSEI

# Strategy Configuration
TIMEFRAME=5minute
EMA_PERIOD=5

# Optional: Logging Level (info, debug, error)
LOG_LEVEL=info

# Optional: Alert cooldown in minutes (prevents spam alerts)
ALERT_COOLDOWN_MINUTES=2

# Instructions:
# 1. For Upstox (Premium/Paid): Use bot.js with UPSTOX_ACCESS_TOKEN
# 2. For Alpha Vantage (Free): Use bot-alphavantage.js with ALPHA_VANTAGE_API_KEY
